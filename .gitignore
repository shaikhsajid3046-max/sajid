# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source files (too large for git)
*.psd
*.aep
*.mov
*.ai
raw-assets/

# source asset folders (keep page.tsx, ignore raw files)
app/assets/photoshop/
app/assets/illustrator/
app/assets/premiere-pro/
app/assets/after-effects/

# large media files exceeding GitHub's 100MB limit
public/assets/premiere-pro/show-reel.mp4
